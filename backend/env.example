# ──────────────────────────────────────────────────────────
# GigCredit — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
# ──────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gigcredit?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=gigcredit_super_secret_change_this_in_production
JWT_EXPIRES_IN=7d

# Bcrypt salt rounds (10 is secure; higher = slower)
BCRYPT_SALT_ROUNDS=10

# CORS — comma-separated list of allowed frontend origins
# Use * for local dev, set to deployed frontend URL in production
CORS_ORIGIN=http://localhost:5173

# Suspicious transaction thresholds (tunable)
SUSPICIOUS_LARGE_AMOUNT=100000
SUSPICIOUS_RAPID_COUNT=5
SUSPICIOUS_RAPID_WINDOW_MINUTES=10
